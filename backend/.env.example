# Copy to .env to override. Every value below has a working default for localhost.

# Change this before deploying anywhere.
JWT_SECRET=dev-only-secret-change-me

# Demo accounts created on first run and shown on the login page.
# Set DEMO_MODE=false before deploying to hide them from the login page.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@hackyard.demo
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_USER_EMAIL=user@hackyard.demo
DEMO_USER_PASSWORD=User@12345

# Optional: free Gemini key for the AI brief. Without it a template brief is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: AI check of the photos citizens attach to reports.
# Paste one key; the provider is recognised from it:
#   xai-...  = Grok (xAI)      gsk_...  = Groq      AIza...  = Gemini
# Without a key, reports still get the duplicate and photo-metadata checks.
VISION_API_KEY=
# Only needed to override the automatic choice:
# VISION_PROVIDER=grok
# VISION_MODEL=
# How many reports one user may send per day.
REPORTS_PER_DAY=10

# SQLite file next to the backend by default. A Postgres URL (e.g. Neon free tier) also works.
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Radius (km) around the city centre that is analysed, and weather refresh interval.
CITY_RADIUS_KM=7
REFRESH_MINUTES=15
